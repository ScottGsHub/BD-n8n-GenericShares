    {
      "parameters": {
        "jsCode": "const row = $input.item.json;\n\n// Clean website_canonical — strip protocol and trailing slash\nconst websiteCanonical = (row.website_canonical || row.website || '')\n  .toLowerCase()\n  .replace(/^https?:\\/\\//, '')\n  .replace(/\\/$/, '');\n\n// Generate a random password for the BD account\nconst password = Math.random().toString(36).slice(-8) + 'A1!';\n\n// Build the clean listing object for Supabase insert\nconst listing = {\n  listing_type: row.listing_type || 'Company',\n  logo: row.logo || null,\n  cover_photo: row.cover_photo || null,\n  profile_photo: row.profile_photo || null,\n  first_name: row.first_name || null,\n  last_name: row.last_name || null,\n  email: row.email || null,\n  company: row.company || null,\n  phone_number: row.phone_number || null,\n  fax_number: row.fax_number || null,\n  address1: row.address1 || null,\n  address2: row.address2 || null,\n  city: row.city || null,\n  zip_code: row.zip_code || null,\n  state_code: row.state_code || null,\n  country_code: row.country_code || null,\n  website: row.website || null,\n  website_canonical: websiteCanonical,\n  twitter: row.twitter || null,\n  facebook: row.facebook || null,\n  linkedin: row.linkedin || null,\n  youtube: row.youtube || null,\n  instagram: row.instagram || null,\n  tiktok: row.tiktok || null,\n  discord: row.discord || null,\n  about_me: row.about_me || null,\n  about_me_staging: row.about_me_staging || row.about_me || null,\n  search_description: row.search_description || null,\n  profession_name: row.profession_name || null,\n  services: row.services || null,\n  published: true,\n  verified: false,\n  source: 'manual',\n  status: 'export_ready',\n  import_batch_id: $('Read AI Complete Rows').item.json.import_batch_id || null,\n  password: password\n};\n\n// Remove null values to keep insert clean\nObject.keys(listing).forEach(k => {\n  if (listing[k] === null || listing[k] === '') delete listing[k];\n});\n\n// Always keep these even if empty\nlisting.published = true;\nlisting.verified = false;\nlisting.source = 'manual';\nlisting.status = 'export_ready';\nlisting.website_canonical = websiteCanonical;\n\n// Store metadata in fields that won't conflict with Supabase columns\nlisting.password = password;\n\nreturn [{ json: {\n  ...listing }}];"
      },
      "id": "da83efec-a276-40ef-be71-0db54905748b",
      "name": "Prepare Listing Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -96,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const storeNode = $('Store BD Member ID').item.json;\nconst mergeNode = $('Merge Category Results to Listing Data').item.json;\n\nconst listingId = storeNode.listing_id || mergeNode.listing_id;\nconst professionName = mergeNode.listing?.profession_name || '';\nconst servicesRaw = mergeNode.listing?.services || '';\nconst topCategoryId = mergeNode.top_category_id;\n\nif (!listingId) throw new Error('No listing_id available for category insert.');\n\nconst categoryRows = [];\n\nif (servicesRaw && servicesRaw.trim() !== '') {\n  const pairs = servicesRaw.split(',').map(s => s.trim()).filter(Boolean);\n\n  pairs.forEach((pair, index) => {\n    const parts = pair.split('=>').map(s => s.trim());\n    const subName = parts[0] || null;\n    const subSubName = parts[1] || null;\n\n    categoryRows.push({\n      listing_id: listingId,\n      sub_name: subName,\n      subsub_name: subSubName,\n      is_primary_top: index === 0\n    });\n  });\n}\n\nreturn categoryRows.map(row => ({ json: row }));"
      },

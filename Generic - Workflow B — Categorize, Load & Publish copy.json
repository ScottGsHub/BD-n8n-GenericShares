    {
      "parameters": {
        "jsCode": "const bdResponse = $input.item.json;\nconst prev = $('Merge Category Results to Listing Data').item.json;\n\nif (prev.skipped || bdResponse.skipped) {\n  return [{ json: { skipped: true, reason: prev.reason || 'upstream skipped' } }];\n}\n\nconst bdMemberId = bdResponse?.message?.user_id \n  || bdResponse?.message?.member_id \n  || bdResponse?.message?.id \n  || bdResponse?.id \n  || null;\n\nreturn [{ json: {\n  listing_id: String(prev.listing_id || ''),\n  bd_member_id: bdMemberId ? String(bdMemberId) : null,\n  row_number: Number(prev.row_number) || 0,\n  website: String(prev.website || ''),\n  website_canonical: String(prev.website_canonical || ''),\n  bd_response: JSON.stringify(bdResponse).slice(0, 500)\n} }];"
      },

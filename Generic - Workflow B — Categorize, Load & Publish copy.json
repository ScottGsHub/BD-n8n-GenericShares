      "parameters": {
        "jsCode": "const items = $input.all();\nconst prepareData = $('Prepare Listing Data').first().json;\nconst createRowResult = $('Create a row').first().json;\n\nconst listingId = createRowResult?.id || null;\nif (!listingId) {\n  return [{ json: { skipped: true, reason: 'no_listing_id' } }];\n}\n\nconst categoryResult = items[0]?.json;\nconst topCategoryId = categoryResult?.id || null;\n\nif (!topCategoryId) {\n  return [{ json: { skipped: true, reason: 'Top category not found' } }];\n}\n\nreturn [{ json: {\n  listing_id: String(listingId),\n  password: String(prepareData.password || ''),\n  row_number: Number($('Loop Over Items').first().json.row_number) || 0,\n  website: String(prepareData.website || ''),\n  website_canonical: String(prepareData.website_canonical || ''),\n  top_category_id: String(topCategoryId),\n  listing: {\n    email: String(prepareData.email || ''),\n    company: String(prepareData.company || ''),\n    listing_type: String(prepareData.listing_type || 'Company'),\n    logo: String(prepareData.logo || ''),\n    website: String(prepareData.website || ''),\n    twitter: String(prepareData.twitter || ''),\n    facebook: String(prepareData.facebook || ''),\n    linkedin: String(prepareData.linkedin || ''),\n    youtube: String(prepareData.youtube || ''),\n    instagram: String(prepareData.instagram || ''),\n    tiktok: String(prepareData.tiktok || ''),\n    discord: String(prepareData.discord || ''),\n    city: String(prepareData.city || ''),\n    state_code: String(prepareData.state_code || ''),\n    country_code: String(prepareData.country_code || ''),\n    profession_name: String(prepareData.profession_name || ''),\n    services: String(prepareData.services || ''),\n    search_description: String(prepareData.search_description || ''),\n    about_me: String(prepareData.about_me || ''),\n    password: String(prepareData.password || '')\n  }\n} }];"

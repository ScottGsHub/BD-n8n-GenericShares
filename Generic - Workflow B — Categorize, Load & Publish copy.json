        "jsCode": "const items = $input.all();\n\nconst publishedCount = items.filter(i => !i.json.skipped).length;\nconst skippedCount = items.filter(i => i.json.skipped).length;\nconst skippedReasons = items\n  .filter(i => i.json.skipped && i.json.reason)\n  .map(i => i.json.reason);\n\nreturn [{ json: {\n  publishedCount,\n  skippedCount,\n  skippedReasons: skippedReasons.join(' | '),\n  completedAt: new Date().toISOString()\n}}];"
